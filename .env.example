# Copy this file to .env before starting Compose. The three required values are
# intentionally empty so Compose fails closed until you replace them.

# Server and required administrator credentials
PORT=5000
CONFIG_USER=
CONFIG_PASS=
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Redis (the bundled Compose service uses these values)
REDIS_HOST=redis
REDIS_PORT=6379

# Browser and proxy security
ENVIRONMENT=production
CORS_ORIGINS=
ALLOW_DEV_CORS=false
TRUSTED_IPS=127.0.0.1,::1
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Enable only when every request reaches the app through a trusted reverse proxy.
TRUST_PROXY=false
USE_CLOUDFLARE=false
ALLOWED_DOMAIN=
WS_SKIP_ORIGIN_CHECK=false

# Network access policy
# Set true only when intentionally diagnosing private/internal addresses.
ALLOW_PRIVATE_IPS=false
# Loopback and link-local destinations require separate explicit opt-in.
ALLOW_LOOPBACK_IPS=false
ALLOW_LINK_LOCAL_IPS=false

# Diagnostic feature flags
ENABLE_WHOIS=true
ENABLE_DNS=true
ENABLE_CT=true
ENABLE_SSL=true
ENABLE_HTTP=true
ENABLE_GEO=true
AUTO_UPDATE_DATABASES=false

# DNS
DNS_SERVERS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query
BOOTSTRAP_DNS=1.1.1.1,9.9.9.9
DNS_MAX_ATTEMPTS=3

# Bounded concurrency and port-scan limits
MAX_TARGET_CONCURRENCY=4
MAX_SERVICE_CONCURRENCY=12
PORT_SCAN_CONCURRENCY=32
PORT_SCAN_MAX_PORTS=1024

# Optional GeoIP database credentials
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional SEO metadata
SEO_ENABLED=false
SEO_DOMAIN=

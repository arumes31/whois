# Server
PORT=5000

# SECRET_KEY must be a strong random secret. Generate it via openssl or a secrets manager.
# NEVER use or commit the example value below in production.
SECRET_KEY=DO_NOT_USE_IN_PRODUCTION__REPLACE_WITH_SECURE_RANDOM_VALUE


# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # planned — not yet read by config

# Authentication
# In production, change CONFIG_USER and CONFIG_PASS to strong, unique credentials.
CONFIG_USER=CHANGE_ME
CONFIG_PASS=CHANGE_ME

# GeoIP (MaxMind license — leave empty for public mirror fallback)
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# CORS (leave empty for wildcard * in development)
CORS_ORIGINS=

# Proxy/CDN
TRUST_PROXY=false
USE_CLOUDFLARE=false

# Feature Flags
ENABLE_WHOIS=true
ENABLE_DNS=true
ENABLE_CT=true
ENABLE_SSL=true
ENABLE_HTTP=true
ENABLE_GEO=true
# ENABLE_PING=true          # planned — not yet read by config
# ENABLE_TRACEROUTE=true    # planned — not yet read by config
# ENABLE_SCANNER=true       # planned — not yet read by config
# ENABLE_MAC=true           # planned — not yet read by config

# DNS
DNS_RESOLVER=

# Private IPs (set to true to allow scanning private/internal IPs)
ALLOW_PRIVATE_IPS=false

# Monitoring
# ENABLE_MONITORING=false   # planned — not yet read by config

# SEO
SEO_ENABLED=false

# Server
PORT=5000
SECRET_KEY=change-me-locally-for-security

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # planned — not yet read by config

# Authentication
CONFIG_USER=admin
CONFIG_PASS=admin

# GeoIP (MaxMind license — leave empty for public mirror fallback)
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# CORS (leave empty for wildcard * in development)
CORS_ORIGINS=

# Proxy/CDN
TRUST_PROXY=false
USE_CLOUDFLARE=false

# Feature Flags
ENABLE_WHOIS=true
ENABLE_DNS=true
ENABLE_CT=true
ENABLE_SSL=true
ENABLE_HTTP=true
ENABLE_GEO=true
# ENABLE_PING=true          # planned — not yet read by config
# ENABLE_TRACEROUTE=true    # planned — not yet read by config
# ENABLE_SCANNER=true       # planned — not yet read by config
# ENABLE_MAC=true           # planned — not yet read by config

# DNS
DNS_RESOLVER=

# Private IPs (set to true to allow scanning private/internal IPs)
ALLOW_PRIVATE_IPS=false

# Monitoring
# ENABLE_MONITORING=false   # planned — not yet read by config

# SEO
SEO_ENABLED=false
